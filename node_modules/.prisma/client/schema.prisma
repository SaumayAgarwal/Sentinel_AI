generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id              String           @id @default(cuid())
  incidentId      String?          @unique // Stable ID alias (e.g. INC-...)
  projectId       String           @default("ecommerce-001")
  serviceId       String
  serviceName     String
  type            String // SERVICE_DOWN, HIGH_ERROR_RATE, HIGH_LATENCY
  severity        String // LOW, MEDIUM, HIGH, CRITICAL
  status          String // OPEN, ACKNOWLEDGED, INVESTIGATING, RECOVERING, RESOLVED, FAILED
  reason          String? // Summary reason for failure
  recoveryStatus  String? // PENDING, IN_PROGRESS, SUCCESS, FAILED
  timeline        Json[] // Array of { timestamp, event, details }
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  metadata        Json?
  recoveryActions RecoveryAction[]

  @@index([projectId])
  @@index([serviceId])
  @@index([status])
}

model RecoveryAction {
  id               String    @id @default(cuid())
  recoveryActionId String    @unique // e.g. REC-1725512345
  projectId        String    @default("ecommerce-001")
  incidentId       String
  incident         Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  serviceId        String
  actionType       String // RESTART, CLEAR_CACHE, SCALE, ROLLBACK
  requestedBy      String    @default("SYSTEM") // SYSTEM | OPERATOR | AI_AGENT
  status           String    @default("PENDING") // PENDING | IN_PROGRESS | SUCCESS | FAILED
  attempt          Int       @default(1)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  result           Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId])
  @@index([incidentId])
  @@index([serviceId])
}

model ServiceEvent {
  id        String   @id @default(cuid())
  projectId String   @default("ecommerce-001")
  serviceId String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([serviceId])
}

model DlqEvent {
  id                    String   @id @default(cuid())
  eventId               String   @unique
  projectId             String   @default("ecommerce-001")
  originalTopic         String
  eventType             String
  service               String
  payload               Json
  retryCount            Int      @default(0)
  errorReason           String
  status                String   @default("FAILED") // FAILED | REPLAYED | DELETED
  firstFailureTimestamp DateTime
  lastFailureTimestamp  DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([projectId])
}

model AIInvestigation {
  id              String    @id @default(cuid())
  investigationId String    @unique // e.g. INV-1725512345
  projectId       String    @default("ecommerce-001")
  incidentId      String    @unique // 1:1 with Incident for dedup
  serviceId       String
  status          String    @default("PENDING") // PENDING | INVESTIGATING | DIAGNOSED | RECOVERY_REQUESTED | RECOVERING | RECOVERED | RESOLVED | FAILED | INCONCLUSIVE
  diagnosis       String?
  rootCause       String?
  confidence      Float?
  severity        String?
  evidence        Json? // Stored relevant evidence: health, dependencies, metrics, logs
  recommendation  Json? // { action, target, reason, confidence }
  recovery        Json? // { status, actionType, requestedBy, recoveryActionId, verified }
  llmCalls        Int       @default(0)
  toolCalls       Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
  @@index([serviceId])
  @@index([status])
}

model IncidentEmbedding {
  id             String                       @id @default(cuid())
  incidentId     String                       @unique
  projectId      String                       @default("ecommerce-001")
  serviceId      String
  content        String
  embeddingModel String                       @default("text-embedding-3-small")
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@index([projectId])
  @@index([serviceId])
}
