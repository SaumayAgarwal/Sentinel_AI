generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Incident {
  id          String    @id @default(cuid())
  serviceId   String
  serviceName String
  type        String // SERVICE_DOWN, HIGH_ERROR_RATE, HIGH_LATENCY
  severity    String // LOW, MEDIUM, HIGH, CRITICAL
  status      String // OPEN, ACKNOWLEDGED, INVESTIGATING, RECOVERING, RESOLVED, FAILED
  timeline    Json[] // Array of { timestamp, event, details }
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  metadata    Json?
}

model ServiceEvent {
  id        String   @id @default(cuid())
  serviceId String
  eventType String
  payload   Json
  createdAt DateTime @default(now())
}
